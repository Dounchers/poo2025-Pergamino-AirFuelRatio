# --- VARIABLES DE ENTORNO (Verificadas en BD)
# ----------------------------------------------------
@host = http://localhost:8080
@ID_TORNEO_EXISTENTE = 13
@ID_COMP_EXISTENTE = 7
@ID_COMP_BORRAR = 8
@ID_TORNEO_NO_PUBLICADO = 14
@AUTH_ADMIN_TOKEN = Bearer eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhbmFsaWFAdG9ybmVvcy5jb20iLCJpYXQiOjE3NjQ5NjYwNDIsImV4cCI6MTc2NTgzMDA0Mn0.mv5V2GJ9pgp0WGucZb_cZWqUOjgtgvJjHelfUtCDtZqw8D-_Qa72YPn6LgL09VvqH-6mw39EQyDeilqye1Nevg
# ----------------------------------------------------

# --- DTOs de Competencia ---
@COMP_NEW_NAME = "Carrera Nocturna 2026"
@COMP_NEW_CAPACITY = 120
@COMP_NEW_PRICE = 35000.00
@COMP_UPD_NAME = "Carrera Anual Editada"
@COMP_UPD_CAPACITY = 200
@COMP_UPD_PRICE = 40000.00

# ----------------------------------------------------
# 1. GESTIÓN DE TORNEOS (DELETE / PATCH)
# ----------------------------------------------------

## 1.1 DELETE - Borrar Torneo (Remove Tournament)
# Resultado esperado: 200 OK (Si no está publicado) o 400 Bad Request (Si está publicado).
# @name DELETE_TORNEO
DELETE {{host}}/admin/tournaments/{{ID_TORNEO_NO_PUBLICADO}}
Authorization: {{AUTH_ADMIN_TOKEN}}

###

## 1.2 PATCH - Publicar Torneo (Publish tournament)
# Resultado esperado: 200 OK. El torneo pasa a estar disponible para participantes.
# @name PATCH_PUBLICAR_TORNEO
PATCH {{host}}/admin/tournaments/{{ID_TORNEO_EXISTENTE}}/published
Authorization: {{AUTH_ADMIN_TOKEN}}

###

# ----------------------------------------------------
# 2. GESTIÓN DE COMPETENCIAS (CRUD)
# ----------------------------------------------------

## 2.1 POST - Crear Nueva Competencia (Create Tournament Competition)
# Crea una competencia dentro de un torneo (debe ser un torneo NO publicado o usar uno temporal).
# Resultado esperado: 201 Created.
# @name POST_CREAR_COMPETENCIA
POST {{host}}/admin/tournaments/{{ID_TORNEO_NO_PUBLICADO}}/competitions
Authorization: {{AUTH_ADMIN_TOKEN}}
Content-Type: application/json

{
    "name": {{COMP_NEW_NAME}},
    "cupo": {{COMP_NEW_CAPACITY}},
    "precio": {{COMP_NEW_PRICE}}
}

###

## 2.2 PUT - Actualizar Competencia (Change Tournament competition details)
# Nota: La ruta PUT requiere tanto el ID del torneo como el ID de la competencia
# Resultado esperado: 200 OK.
# @name PUT_ACTUALIZAR_COMPETENCIA
PUT {{host}}/admin/tournaments/{{ID_TORNEO_EXISTENTE}}/competitions/{{ID_COMP_EXISTENTE}}
Authorization: {{AUTH_ADMIN_TOKEN}}
Content-Type: application/json

{
    "name": {{COMP_UPD_NAME}},
    "cupo": {{COMP_UPD_CAPACITY}},
    "precio": {{COMP_UPD_PRICE}}
}

###

## 2.3 DELETE - Borrar Competencia (Remove Tournament competition)
# Resultado esperado: 200 OK.
# @name DELETE_COMPETENCIA
DELETE {{host}}/admin/tournaments/{{ID_TORNEO_EXISTENTE}}/competitions/{{ID_COMP_BORRAR}}
Authorization: {{AUTH_ADMIN_TOKEN}}

###

# ----------------------------------------------------
# 3. CONSULTA Y REPORTES DE ADMINISTRACIÓN
# ----------------------------------------------------

## 3.1 GET - Listar Competencias (Get Tournament Competitions)
# Retorna la lista de competencias de un torneo.
# Resultado esperado: 200 OK. Lista de objetos Competencia.
# @name GET_LISTAR_COMPETENCIAS_ADMIN
GET {{host}}/admin/tournaments/{{ID_TORNEO_EXISTENTE}}/competitions
Authorization: {{AUTH_ADMIN_TOKEN}}

###

## 3.2 GET - Detalle de Competencia con Totales (Get Tournament Competition)
# Retorna los detalles, incluyendo las métricas de inscripción y recaudación.
# Resultado esperado: 200 OK. JSON con totalInscripciones y montoTotalRecaudado.
# @name GET_DETALLE_COMPETENCIA_CON_TOTALES
GET {{host}}/admin/tournaments/{{ID_TORNEO_EXISTENTE}}/competitions/{{ID_COMP_EXISTENTE}}
Authorization: {{AUTH_ADMIN_TOKEN}}

###

## 3.3 GET - Listar Inscripciones por Competencia (Get Tournament competition inscriptions)
# Retorna un listado de los participantes (emails) que se inscribieron en una competencia.
# Resultado esperado: 200 OK. Lista de InscripcionDTO.
# @name GET_LISTAR_INSCRIPCIONES
GET {{host}}/admin/tournaments/{{ID_TORNEO_EXISTENTE}}/competitions/{{ID_COMP_EXISTENTE}}/inscripciones
Authorization: {{AUTH_ADMIN_TOKEN}}

###

# ----------------------------------------------------
# 4. GESTIÓN DE ADMINISTRADORES
# ----------------------------------------------------

## 4.1 POST - Autenticar Administrador (Admin Authentication)
# Realiza login de un administrador con email y contraseña.
# Resultado esperado: 200 OK. Retorna token JWT.
# @name POST_AUTH_ADMIN
POST {{host}}/admin/auth
Content-Type: application/json

{
    "email": "analia@torneos.com",
    "password": "analia"
}

###

## 4.2 GET - Listar Cuentas de Administradores (Get admin accounts)
# Lista todos los administradores registrados.
# Resultado esperado: 200 OK. Lista de AdminResponseDTO.
# @name GET_LISTAR_CUENTAS_ADMIN
GET {{host}}/admin/accounts
Authorization: {{AUTH_ADMIN_TOKEN}}

###

## 4.3 POST - Crear Nueva Cuenta de Administrador (Create admin account)
# Crea un nuevo administrador en el sistema.
# Resultado esperado: 201 Created.
# @name POST_CREAR_ADMIN
POST {{host}}/admin/accounts
Authorization: {{AUTH_ADMIN_TOKEN}}
Content-Type: application/json

{
    "email": "nuevo_admin@torneos.com",
    "password": "NuevoAdmin123"
}

###

## 4.4 DELETE - Eliminar Cuenta de Administrador (Delete admin account)
# Elimina una cuenta de administrador (no puede ser la del usuario actual).
# Resultado esperado: 204 No Content.
# @name DELETE_ADMIN_ACCOUNT
DELETE {{host}}/admin/accounts/5
Authorization: {{AUTH_ADMIN_TOKEN}}

###

# ---

# VARIABLES DE TORNEOS PARA PRUEBAS (Agregar si es necesario)
@TORNEO_NEW_NAME = "Torneo de Prueba 2026"
@TORNEO_NEW_DESCRIPTION = "Torneo para tests de endpoints"
@TORNEO_NEW_DATE_START = "2024-03-01"
@TORNEO_NEW_DATE_END = "2024-03-31"
@TORNEO_UPD_NAME = "Torneo Editado"
@TORNEO_UPD_DESCRIPTION = "Descripción actualizada"
@TORNEO_UPD_DATE_START = "2024-04-01"
@TORNEO_UPD_DATE_END = "2024-04-30"
###

# ----------------------------------------------------
# 5. GESTIÓN COMPLETA DE TORNEOS
# ----------------------------------------------------

## 5.1 GET - Listar Todos los Torneos (Get Tournaments)
# Retorna la lista de todos los torneos.
# Resultado esperado: 200 OK. Lista de TournamentListResponseDTO.
# @name GET_LISTAR_TORNEOS
GET {{host}}/admin/tournaments
Authorization: {{AUTH_ADMIN_TOKEN}}

###

## 5.2 GET - Obtener Detalles de Torneo (Get Tournament by ID)
# Retorna los detalles de un torneo específico con totales.
# Resultado esperado: 200 OK. TournamentResponseDTO con totalEnrollments y totalRevenue.
# @name GET_DETALLE_TORNEO
GET {{host}}/admin/tournaments/{{ID_TORNEO_EXISTENTE}}
Authorization: {{AUTH_ADMIN_TOKEN}}

###

## 5.3 POST - Crear Nuevo Torneo (Create Tournament)
# Crea un nuevo torneo en el sistema.
# Resultado esperado: 201 Created.
# @name POST_CREAR_TORNEO
POST {{host}}/admin/tournaments
Authorization: {{AUTH_ADMIN_TOKEN}}
Content-Type: application/json

{
    "name": {{TORNEO_NEW_NAME}},
    "description": {{TORNEO_NEW_DESCRIPTION}},
    "dateStart": {{TORNEO_NEW_DATE_START}},
    "dateEnd": {{TORNEO_NEW_DATE_END}}
}

###

## 5.4 PUT - Actualizar Torneo (Update Tournament)
# Actualiza los detalles de un torneo existente.
# Resultado esperado: 200 OK. TournamentListResponseDTO actualizado.
# @name PUT_ACTUALIZAR_TORNEO
PUT {{host}}/admin/tournaments/{{ID_TORNEO_EXISTENTE}}
Authorization: {{AUTH_ADMIN_TOKEN}}
Content-Type: application/json

{
    "name": {{TORNEO_UPD_NAME}},
    "description": {{TORNEO_UPD_DESCRIPTION}},
    "dateStart": {{TORNEO_UPD_DATE_START}},
    "dateEnd": {{TORNEO_UPD_DATE_END}}
}

###